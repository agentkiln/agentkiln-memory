{$AML_DOMAIN} {
  encode zstd gzip
  reverse_proxy 127.0.0.1:8000
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
  }
  log {
    output file /var/log/caddy/agentkiln-access.log
    format json
  }
}

